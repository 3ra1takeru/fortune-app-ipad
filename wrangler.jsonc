{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "ipad-fortune-app",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fortune-app-db",
      "database_id": "d99d97dc-87aa-4bf4-9138-a4bb6bf3b7ab"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ipad-fortune-app"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "test": {
      "name": "ipad-fortune-app-test",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fortune-app-db-test",
          "database_id": "4f61db8e-ab46-4bd2-8ffe-8e560c893e8a"
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "ipad-fortune-app-test"
        }
      ]
    }
  }
}
